{
    "name": "schemastud/laravel-beam-accounts",
    "description": "The account engine of the schemastud stack: Fortify/session as the default auth substrate, the whole self-service account runtime (profile/security surface + Fortify registration/reset actions), and the generic team/membership/invitation primitives on the permission-cascade base leaf. A capability peer of the beam family; concrete tenant-provisioning + demo stay in the consuming satellite. Not Passport.",
    "keywords": [
        "laravel",
        "schemastud",
        "beam",
        "fortify",
        "account",
        "teams"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "laravel/fortify": "^1.20",
        "rushing/laravel-permission-cascade": "*",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "laravel/sanctum": "Install in a satellite to activate its own opt-in token 'api' guard seam alongside the engine's session/Fortify web guard.",
        "schemastud/laravel-beam": "The app-substrate rung; require it in a host that also persists schema records."
    },
    "autoload": {
        "psr-4": {
            "Schemastud\\Beam\\Accounts\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\Beam\\Accounts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Schemastud\\Beam\\Accounts\\BeamAccountsServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../rushing/laravel-permission-cascade",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
